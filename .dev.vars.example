# Cloudflare Worker 本地开发环境变量模板
# 复制此文件为 .dev.vars 并填入真实值

# ───────────────────────────────────────
# 部署凭证（必须）
# 创建：https://dash.cloudflare.com/profile/api-tokens
# 权限：Workers Scripts: Edit + KV Storage: Edit + Pages: Edit
# 格式：cfat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ───────────────────────────────────────
CLOUDFLARE_API_TOKEN=cfat_your_api_token_here

# ───────────────────────────────────────
# 管理员登录 Token（必须）
# 用户登录后台时在 Token 字段填写的值
# 生成方式：openssl rand -hex 32
# ───────────────────────────────────────
ADMIN_API_TOKEN=your_admin_token_here

# ───────────────────────────────────────
# Account ID（可选）
# 获取：Cloudflare Dashboard → 右侧边栏
# ───────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
