# Cloudflare Worker 环境变量模板
# 复制此文件为 .dev.vars 并填入真实值

# Cloudflare API Token（部署凭证）
# 创建：https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-api-token-here

# Cloudflare Account ID（可选，可从 Dashboard 获取）
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# 本地开发用 API Token（测试认证用）
# 格式：任意非空字符串
CLOUDFLARE_API_TOKEN=dev-token-12345
